# Frontend API base URL — Azure QA by default for local Vite
VITE_API_BASE_URL=https://api.qa.tummly.com/api

# Optional: local backend (create .env.development.local to override without editing this)
# VITE_API_BASE_URL=http://localhost:5204/api

# QA admin tools (Delete trial row): set on Azure SWA / GHA (qa-frontend sets VITE_APP_ENV=qa)
# VITE_APP_ENV=qa

# Google Analytics 4 measurement ID (Production only recommended)
VITE_GA_MEASUREMENT_ID=G-F6L****PV1

# -----------------------------------------------------------------------------
# Developer tooling (not used by the Vite app at runtime)
# -----------------------------------------------------------------------------
# Figma REST API — optional fallback when the Figma MCP plugin is unavailable.
# Create a personal access token: Figma → Settings → Security → Personal access tokens
# Copy this file to .env (gitignored) and set the value there, or export in your shell.
# FIGMA_ACCESS_TOKEN=
