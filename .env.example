# Frontend API base URL — Azure QA by default for local Vite
VITE_API_BASE_URL=https://api.qa.tummly.com/api

# Optional: local backend (create .env.development.local to override without editing this)
# VITE_API_BASE_URL=http://localhost:5204/api

# Product demo (/product-demo): needs API DemoSession:Enabled + seeded OwnerEmail.
# See backend/tools/ProductDemoSeed/README.md

# QA admin tools (Delete trial row): set on Azure SWA / GHA (qa-frontend sets VITE_APP_ENV=qa)
# VITE_APP_ENV=qa

# Google Analytics 4 measurement ID (Production only recommended)
VITE_GA_MEASUREMENT_ID=G-F6L****PV1

# Google reCAPTCHA v3 — Guest feedback form (site key is public).
# Create keys at https://www.google.com/recaptcha/admin (reCAPTCHA v3).
# Leave unset locally to skip client-side execute (API also skips when secret unset).
# VITE_RECAPTCHA_SITE_KEY=

# Team & Permissions — Owner Admin-column matrix edits (default off)
# VITE_TEAM_PERMISSIONS_MATRIX_EDIT=true

# Public marketing media (Azure Blob container `marketing` on sttummlyqavfavue).
# Default in code points at QA; override for other envs. No trailing slash.
# VITE_MARKETING_MEDIA_BASE_URL=https://sttummlyqavfavue.blob.core.windows.net/marketing
# After changing source images under src/assets/images, republish variants:
#   npm run marketing-media:publish

# -----------------------------------------------------------------------------
# Developer tooling (not used by the Vite app at runtime)
# -----------------------------------------------------------------------------
# Figma REST API — optional fallback when the Figma MCP plugin is unavailable.
# Create a personal access token: Figma → Settings → Security → Personal access tokens
# Copy this file to .env (gitignored) and set the value there, or export in your shell.
# FIGMA_ACCESS_TOKEN=
