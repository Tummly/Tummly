# Copy these into Railway → TummlyBackend service → Variables
# Railway uses double-underscore nesting for .NET configuration keys.
#
# Database: SQL Server on DigitalOcean VPS (see backend/TummlyDb/vps/)

ASPNETCORE_ENVIRONMENT=Production

# Replace YOUR_VPS_IP and password with values from the VPS .env file
ConnectionStrings__DefaultConnection=Server=YOUR_VPS_IP,1433;Database=TummlyDB;User Id=sa;Password=YOUR_SA_PASSWORD;TrustServerCertificate=True;Encrypt=False;

# Optional Redis — leave unset for single-instance (QA / early prod).
# When set: SignalR Redis backplane for Notifications + Feedback/Home (ADR-0011).
# Required before scaling to more than one API instance. Fail-fast if unreachable.
# ConnectionStrings__Redis=YOUR_REDIS_HOST:6379,password=YOUR_REDIS_PASSWORD,ssl=True

# Run EF migrations on each deploy (recommended for QA)
Database__ApplyMigrationsOnStartup=true

# Frontend QA URL
Frontend__BaseUrl=https://tummly.vercel.app

Cors__AllowedOrigins__0=https://tummly.vercel.app
Cors__AllowedOrigins__1=http://localhost:5173

JwtSettings__Secret=replace-with-a-long-random-secret
JwtSettings__Issuer=TummlyAPI
JwtSettings__Audience=TummlyClient
JwtSettings__ExpiryMinutes=60

# Resend (HTTPS — works on Railway Hobby, no Pro plan needed)
# Sign up at https://resend.com → API Keys
# QA: use onboarding@resend.dev as sender (can only deliver to your Resend account email until tummly.com is verified)
EmailSettings__ApiKey=re_your_api_key
EmailSettings__SenderName=Tummly
EmailSettings__SenderEmail=onboarding@resend.dev
EmailSettings__ReplyToEmail=engineering@tummly.com
# Until tummly.com is verified on Resend, redirect all sends to your Resend account inbox
EmailSettings__QaRedirectTo=engineering@tummly.com

# Ideal Postcodes (UK address lookup) — https://ideal-postcodes.co.uk/
IdealPostcodes__ApiKey=ak_your_api_key

# Twilio Verify (sign-in SMS OTP) — https://console.twilio.com/
# Create a Verify service, then copy its Service SID (VA...).
TwilioSettings__AccountSid=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TwilioSettings__AuthToken=your_auth_token
TwilioSettings__VerifyServiceSid=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: ISO region for parsing numbers without + (default GB)
TwilioSettings__DefaultRegion=GB

# QA only — enables DELETE /api/admin/trial-requests/{id}
Admin__AllowTrialPurge=true

# Object storage for Help Centre query attachments (ADR-0007)
# Provider: S3 (DigitalOcean Spaces, default) or AzureBlob
# ObjectStorage__Provider=S3
# ObjectStorage__Endpoint=https://sgp1.digitaloceanspaces.com
# ObjectStorage__Bucket=tummly-bucket
# If you paste the bucket URL by mistake, that also works — we normalize it:
#   https://tummly-bucket.sgp1.digitaloceanspaces.com
# No quotes around values in Railway (wrong: "tummly-bucket", right: tummly-bucket)
# ObjectStorage__AccessKey=your_spaces_key
# ObjectStorage__SecretKey=your_spaces_secret
#
# Azure QA (Provider=AzureBlob) — container + service URI; auth via managed identity
# unless ObjectStorage__ConnectionString is set (local key auth).
# ObjectStorage__Provider=AzureBlob
# ObjectStorage__Endpoint=https://sttummlyqavfavue.blob.core.windows.net
# ObjectStorage__Bucket=help-centre-attachments
# ObjectStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Feedback AI classification (Azure OpenAI Structured Outputs)
# Local/demo: Provider=Fake. QA/prod with real badges: AzureOpenAI + keys.
# Live SignalR fan-out: single instance without Redis; set ConnectionStrings__Redis before N>1 (ADR-0011).
FeedbackClassification__Provider=AzureOpenAI
FeedbackClassification__Endpoint=https://YOUR_RESOURCE.openai.azure.com/
FeedbackClassification__ApiKey=your_azure_openai_key
FeedbackClassification__DeploymentName=gpt-4o-mini
# Optional durability knobs (defaults match ADR-0010)
# FeedbackClassification__MaxClaimAttempts=3
# FeedbackClassification__ClaimLeaseMinutes=10
# FeedbackClassification__SweepIntervalSeconds=30
# FeedbackClassification__MaxDegreeOfParallelism=1

# Guest mic STT (Azure AI Speech). Local/demo: Provider=Fake.
SpeechToText__Provider=AzureSpeech
SpeechToText__Endpoint=https://YOUR_REGION.api.cognitive.microsoft.com/
SpeechToText__ApiKey=your_azure_speech_key

# Optional: local dev SMTP fallback when ApiKey is not set (Gmail, Freeola, etc.)
