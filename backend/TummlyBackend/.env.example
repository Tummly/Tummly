# Azure QA / local API env template.
# Nesting: use double underscores for .NET configuration keys.
#
# Azure QA values are applied to the Container App via infra/qa/secrets.qa.env
# + infra/qa/apply-aca-secrets.ps1 (do not commit secrets.qa.env).

ASPNETCORE_ENVIRONMENT=Production

# Azure QA — Azure SQL (REPLACE password from deploy / Key Vault later)
# ConnectionStrings__DefaultConnection=Server=tcp:sql-tummly-qa-centralus.database.windows.net,1433;Initial Catalog=sqldb-tummly-qa;User Id=tummlysqladmin;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=False;Connection Timeout=30;
#
# Local — SQL Express / Docker (typical Development override)
# ConnectionStrings__DefaultConnection=Server=localhost;Database=TummlyDB;Trusted_Connection=True;TrustServerCertificate=True;

# Optional Redis — leave unset for single-instance (QA / early prod).
# When set: SignalR Redis backplane for Notifications + Feedback/Home (ADR-0011).
# Required before scaling to more than one API instance. Fail-fast if unreachable.
# ConnectionStrings__Redis=YOUR_REDIS_HOST:6379,password=YOUR_REDIS_PASSWORD,ssl=True

# Run EF migrations on each deploy (recommended for QA)
Database__ApplyMigrationsOnStartup=true

# Azure QA frontend
Frontend__BaseUrl=https://qa.tummly.com
# Optional: public HTTPS origin for Revolut HPP return URLs when BaseUrl is localhost (local API + Revolut).
# Frontend__RevolutRedirectBaseUrl=https://qa.tummly.com

Cors__AllowedOrigins__0=https://qa.tummly.com
Cors__AllowedOrigins__1=http://localhost:5173

JwtSettings__Secret=replace-with-a-long-random-secret
JwtSettings__Issuer=TummlyAPI
JwtSettings__Audience=TummlyClient
JwtSettings__ExpiryMinutes=60

# Google / Microsoft OAuth (Authorization Code). SPA never holds these secrets.
# Redirect URIs must match the provider app registration exactly.
# Local (scripts/run-local-api.sh loads this file):
#   ExternalAuth__Google__RedirectUri=http://localhost:5204/api/auth/external/google/callback
#   ExternalAuth__Microsoft__RedirectUri=http://localhost:5204/api/auth/external/microsoft/callback
#   Frontend__BaseUrl=http://localhost:5173
# QA Container App:
ExternalAuth__Google__ClientId=
ExternalAuth__Google__ClientSecret=
ExternalAuth__Google__RedirectUri=https://api.qa.tummly.com/api/auth/external/google/callback
ExternalAuth__Microsoft__ClientId=
ExternalAuth__Microsoft__ClientSecret=
ExternalAuth__Microsoft__RedirectUri=https://api.qa.tummly.com/api/auth/external/microsoft/callback

# Optional dedicated HMAC for email unsubscribe tokens. When unset, JwtSettings__Secret is used.
# Unsubscribe__SigningSecret=replace-with-a-long-random-unsubscribe-secret

# Resend — see infra/qa/RESEND-HANDOFF.md for domain verify + QA/Prod From addresses
EmailSettings__ApiKey=re_your_api_key
EmailSettings__SenderName=Tummly
EmailSettings__SenderEmail=onboarding@resend.dev
EmailSettings__ReplyToEmail=engineering@tummly.com
# Keep on Azure QA so test mail does not hit real restaurant inboxes
EmailSettings__QaRedirectTo=engineering@tummly.com

# Ideal Postcodes (UK address lookup) — https://ideal-postcodes.co.uk/
IdealPostcodes__ApiKey=ak_your_api_key

# Google reCAPTCHA v3 — Guest feedback submit (server secret).
# Pair with frontend VITE_RECAPTCHA_SITE_KEY from the same reCAPTCHA v3 key pair.
# When unset, verification is skipped (local / Testing). When set, submit requires
# a valid token with action guest_feedback and score >= MinScore.
Recaptcha__SecretKey=
Recaptcha__MinScore=0.5
# Recaptcha__VerifyUrl=https://www.google.com/recaptcha/api/siteverify

# Twilio Verify (sign-in SMS OTP) — https://console.twilio.com/
TwilioSettings__AccountSid=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TwilioSettings__AuthToken=your_auth_token
TwilioSettings__VerifyServiceSid=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TwilioSettings__DefaultRegion=GB
# Guest Recovery SMS From (also the intended Campaign SMS From when outbound
# SMS ships). Prefer branded alphanumeric Sender ID for UK (no number lease):
#   TwilioSettings__RecoveryFromNumber=Tummly
# Or an E.164 leased number / Messaging sender id. Empty → Recovery SMS fails
# closed ("Recovery SMS is not configured."). UK: dynamic alpha is supported;
# avoid generic IDs (SMS, Info, Verify, …). Alpha is one-way — guests cannot
# reply STOP; use InboundNumberRestaurants + a leased To for STOP webhook.
# Console: Messaging → Settings → enable Alphanumeric Sender ID; then
# Numbers and Senders → Alphanumeric senders (or Trust Hub if registration
# is required for a protected ID). Guidelines:
# https://www.twilio.com/en-us/guidelines/gb/sms
TwilioSettings__RecoveryFromNumber=
# Inbound SMS STOP routing: E.164 To number → restaurantId.
# Nested env key uses the +E.164 literal (colon form also works in appsettings).
# Example: TwilioSettings__InboundNumberRestaurants__+447700900123=42
# Unmapped To → log + 200, no withdraw. RecoveryFromNumber alone does not
# auto-withdraw across restaurants (fail closed).
# TwilioSettings__InboundNumberRestaurants__+447700900123=

# Revolut Merchant (live / sandbox — separate accounts, maps, and secrets).
# Leave empty locally until sandbox keys exist. Never commit real values.
# Fail-closed before customer / subscription / pay-order create when any
# required A/B key or target PlanVariations entry is missing.
# QA test-card rehearsal: infra/qa/REVOLUT-QA-SANDBOX.md
# ACA / Key Vault HITL checklist: infra/qa/REVOLUT-GO-LIVE.md
# QA: set RequireSandboxHost=true and ApiBaseUrl to sandbox (blocks live host).
Revolut__RequireSandboxHost=true
Revolut__SecretKey=
Revolut__WebhookSigningSecret=
Revolut__ApiBaseUrl=https://sandbox-merchant.revolut.com
Revolut__ApiVersion=2026-04-20
# Launch VAT mode (env-only boolean). Default false = net charges, no
# vat_not_ready, no VAT invoices/UI. Unset / empty → false.
# Billing pack v3.0 “VAT on all launch charges” is overridden for launch by
# this flag; set true only after HMRC registration + gross variations.
TUMMLY_VAT_MODE_ACTIVE=false
# true → require TUMMLY_VAT_* / legal keys + Revolut__PlanVariationsGross__*

# Net map (used when TUMMLY_VAT_MODE_ACTIVE=false) — eight recurring lookup keys →
# plan_variation_id (sandbox or Production). Create via
# scripts/revolut-create-plan-variations/ (ticket 13). Sandbox may also use
# gitignored .env.revolut.sandbox.local (see .example beside this file).
# Top-ups need no variation UUID.
Revolut__PlanVariations__tummly_starter_monthly_gbp_v3=
Revolut__PlanVariations__tummly_starter_annual_gbp_v3=
Revolut__PlanVariations__tummly_growth_monthly_gbp_v3=
Revolut__PlanVariations__tummly_growth_annual_gbp_v3=
Revolut__PlanVariations__tummly_group_monthly_gbp_v3=
Revolut__PlanVariations__tummly_group_annual_gbp_v3=
Revolut__PlanVariations__tummly_group_location_monthly_gbp_v3=
Revolut__PlanVariations__tummly_group_location_annual_gbp_v3=

# Gross map (used when TUMMLY_VAT_MODE_ACTIVE=true) — same eight keys, gross GBP
# (net + 20%). Create matching Merchant variations before flipping mode.
Revolut__PlanVariationsGross__tummly_starter_monthly_gbp_v3=
Revolut__PlanVariationsGross__tummly_starter_annual_gbp_v3=
Revolut__PlanVariationsGross__tummly_growth_monthly_gbp_v3=
Revolut__PlanVariationsGross__tummly_growth_annual_gbp_v3=
Revolut__PlanVariationsGross__tummly_group_monthly_gbp_v3=
Revolut__PlanVariationsGross__tummly_group_annual_gbp_v3=
Revolut__PlanVariationsGross__tummly_group_location_monthly_gbp_v3=
Revolut__PlanVariationsGross__tummly_group_location_annual_gbp_v3=

# Seller VAT / legal. Required only when TUMMLY_VAT_MODE_ACTIVE=true (gate skips
# vat_not_ready while mode is off).
TUMMLY_VAT_REGISTRATION_NUMBER=
TUMMLY_VAT_EFFECTIVE_DATE=
TUMMLY_LEGAL_NAME=
TUMMLY_REGISTERED_ADDRESS=

# QA only — enables DELETE /api/admin/trial-requests/{id}
Admin__AllowTrialPurge=true

# Owner Admin-column permission matrix edits (default off in production)
# TeamPermissions__AllowMatrixEdit=true

# Object storage for Help Centre query attachments (ADR-0007)
# Azure QA Container App: Provider=AzureBlob + managed identity (no ConnectionString).
# Local: same QA storage account; set ConnectionString (account key) — do not commit it.
ObjectStorage__Provider=AzureBlob
ObjectStorage__Endpoint=https://sttummlyqavfavue.blob.core.windows.net
ObjectStorage__Bucket=help-centre-attachments
# ObjectStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=sttummlyqavfavue;AccountKey=...;EndpointSuffix=core.windows.net
#
# Legacy S3 / DO Spaces (retired for QA; keep only if you still have a private bucket):
# ObjectStorage__Provider=S3
# ObjectStorage__Endpoint=https://sgp1.digitaloceanspaces.com
# ObjectStorage__Bucket=tummly-bucket
# ObjectStorage__AccessKey=your_spaces_key
# ObjectStorage__SecretKey=your_spaces_secret

# Feedback AI classification (Azure OpenAI Structured Outputs)
# Local/demo: Provider=Fake. QA/prod with real badges: AzureOpenAI + keys.
FeedbackClassification__Provider=AzureOpenAI
FeedbackClassification__Endpoint=https://YOUR_RESOURCE.openai.azure.com/
FeedbackClassification__ApiKey=your_azure_openai_key
FeedbackClassification__DeploymentName=gpt-4o-mini

# Guest mic STT (Azure AI Speech). Local/demo: Provider=Fake.
SpeechToText__Provider=AzureSpeech
SpeechToText__Endpoint=https://YOUR_REGION.api.cognitive.microsoft.com/
SpeechToText__ApiKey=your_azure_speech_key

# Set by Azure Container Apps / GHA — do not paste into local .env unless needed:
# ASPNETCORE_URLS=http://+:8080
# AZURE_CLIENT_ID=<user-assigned managed identity client id>

# Optional: local SMTP fallback when ApiKey is not set (Gmail, Freeola, etc.)
