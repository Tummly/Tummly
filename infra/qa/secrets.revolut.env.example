# Revolut + seller VAT keys for ACA / Key Vault (ticket 27 / lock 10).
# Copy these lines into the gitignored secrets file (secrets.qa.env or Prod
# twin), fill on the operator machine, then run apply-aca-secrets.ps1.
# Never commit filled values. Sandbox and Production use separate accounts,
# maps, and secrets.
#
# QA test-card rehearsal (Sandbox only): infra/qa/REVOLUT-QA-SANDBOX.md
# Production go-live checklist: infra/qa/REVOLUT-GO-LIVE.md
# App placeholders: backend/TummlyBackend/.env.example

# --- A. Seller VAT / legal ---
TUMMLY_VAT_REGISTRATION_NUMBER=
TUMMLY_VAT_EFFECTIVE_DATE=
TUMMLY_LEGAL_NAME=
TUMMLY_REGISTERED_ADDRESS=

# --- B. Revolut Merchant ---
# QA: always Sandbox. Production go-live: live host + RequireSandboxHost=false/omit.
# Sandbox: https://sandbox-merchant.revolut.com
# Production: https://merchant.revolut.com
Revolut__RequireSandboxHost=true
Revolut__ApiBaseUrl=https://sandbox-merchant.revolut.com
Revolut__ApiVersion=2026-04-20
Revolut__SecretKey=
Revolut__WebhookSigningSecret=

# --- C. Eight recurring plan_variation_id UUIDs (this env's Revolut account) ---
# Create via scripts/revolut-create-plan-variations/ (--apply prints these lines).
Revolut__PlanVariations__tummly_starter_monthly_gbp_v3=
Revolut__PlanVariations__tummly_starter_annual_gbp_v3=
Revolut__PlanVariations__tummly_growth_monthly_gbp_v3=
Revolut__PlanVariations__tummly_growth_annual_gbp_v3=
Revolut__PlanVariations__tummly_group_monthly_gbp_v3=
Revolut__PlanVariations__tummly_group_annual_gbp_v3=
Revolut__PlanVariations__tummly_group_location_monthly_gbp_v3=
Revolut__PlanVariations__tummly_group_location_annual_gbp_v3=
